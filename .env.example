# Copy to .env and fill in values. Never commit .env.
# Address of the deployed MultiChainUSDCSend contract on Arc Testnet (source chain).
VITE_MULTISEND_ADDRESS=0x0000000000000000000000000000000000000000

# Address of the deployed MultiChainUSDCSend contract on Arc mainnet.
# Leave as the zero address until the contract is reviewed and deployed to mainnet —
# the app shows Mainnet as preview-only while this is unset.
VITE_MULTISEND_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000

# (Optional) Wallet private key for Foundry deploy scripts. Never commit a real key.
# PRIVATE_KEY=0x...
