# Copy to .env and fill in values. Never commit .env.
# Deployed MultiChainUSDCSend contract per source chain. The app falls back to
# the known addresses in code when a variable is unset; setting them here pins
# the deployment explicitly.

# Arc Testnet (source chain for testnet mode).
VITE_MULTISEND_ADDRESS=0x0000000000000000000000000000000000000000

# Mainnet source chains (mainnet mode). One contract per chain.
VITE_MULTISEND_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
VITE_MULTISEND_ADDRESS_ARBITRUM=0x0000000000000000000000000000000000000000
VITE_MULTISEND_ADDRESS_AVALANCHE=0x0000000000000000000000000000000000000000
VITE_MULTISEND_ADDRESS_BASE=0x0000000000000000000000000000000000000000

# (Optional) Wallet private key for Foundry deploy scripts. Never commit a real key.
# PRIVATE_KEY=0x...
